<!-- SheetVol dark theme: colour keys only. Every key here exists in LightTheme.xaml too;
     SheetVolStyles.xaml and DialogWindow.xaml reach them through DynamicResource, so
     swapping this dictionary restyles the open window (E908). SheetVol's own palette:
     no Autodesk colours, templates, icons or fonts. Key list: Dialog/README.md. -->
<ResourceDictionary x:Class="SheetVol.UI.Dialog.Themes.DarkTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SV.Brush.WindowBackground" Color="#1F2329"/>
    <SolidColorBrush x:Key="SV.Brush.PanelBackground" Color="#23282F"/>
    <SolidColorBrush x:Key="SV.Brush.CardBackground" Color="#2A3038"/>
    <SolidColorBrush x:Key="SV.Brush.CardBorder" Color="#3A424D"/>
    <SolidColorBrush x:Key="SV.Brush.Separator" Color="#353C46"/>

    <!-- Text -->
    <SolidColorBrush x:Key="SV.Brush.Text" Color="#E6E9ED"/>
    <SolidColorBrush x:Key="SV.Brush.TextMuted" Color="#A3ACB8"/>
    <SolidColorBrush x:Key="SV.Brush.TextDisabled" Color="#6B7480"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="SV.Brush.ControlBackground" Color="#1B1F24"/>
    <SolidColorBrush x:Key="SV.Brush.ControlBorder" Color="#4A5360"/>
    <SolidColorBrush x:Key="SV.Brush.ControlHoverBorder" Color="#6B7686"/>
    <SolidColorBrush x:Key="SV.Brush.ControlReadOnlyBackground" Color="#262B32"/>
    <SolidColorBrush x:Key="SV.Brush.FocusBorder" Color="#5AA9E6"/>
    <SolidColorBrush x:Key="SV.Brush.Selection" Color="#2C5C88"/>
    <SolidColorBrush x:Key="SV.Brush.ItemHover" Color="#323944"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="SV.Brush.ButtonBackground" Color="#343B45"/>
    <SolidColorBrush x:Key="SV.Brush.ButtonHover" Color="#3E4652"/>
    <SolidColorBrush x:Key="SV.Brush.ButtonPressed" Color="#2C323A"/>
    <SolidColorBrush x:Key="SV.Brush.ButtonBorder" Color="#4A5360"/>
    <SolidColorBrush x:Key="SV.Brush.Accent" Color="#2F7FC1"/>
    <SolidColorBrush x:Key="SV.Brush.AccentHover" Color="#3A8FD4"/>
    <SolidColorBrush x:Key="SV.Brush.AccentPressed" Color="#276BA3"/>
    <SolidColorBrush x:Key="SV.Brush.AccentText" Color="#FFFFFF"/>

    <!-- States -->
    <SolidColorBrush x:Key="SV.Brush.Error" Color="#F07178"/>
    <SolidColorBrush x:Key="SV.Brush.ErrorBackground" Color="#45282C"/>
    <SolidColorBrush x:Key="SV.Brush.ErrorRowTint" Color="#3A2427"/>
    <SolidColorBrush x:Key="SV.Brush.Warning" Color="#E5B54B"/>
    <SolidColorBrush x:Key="SV.Brush.WarningBackground" Color="#3D3420"/>
    <SolidColorBrush x:Key="SV.Brush.WarningBorder" Color="#6B5A2C"/>
    <SolidColorBrush x:Key="SV.Brush.InfoBackground" Color="#24384C"/>
    <SolidColorBrush x:Key="SV.Brush.InfoBorder" Color="#35506B"/>

    <!-- Status chips -->
    <SolidColorBrush x:Key="SV.Brush.ChipCurrentBackground" Color="#1F3D2B"/>
    <SolidColorBrush x:Key="SV.Brush.ChipCurrentText" Color="#7BD88F"/>
    <SolidColorBrush x:Key="SV.Brush.ChipOutOfDateBackground" Color="#3D3420"/>
    <SolidColorBrush x:Key="SV.Brush.ChipOutOfDateText" Color="#E5B54B"/>
    <SolidColorBrush x:Key="SV.Brush.ChipErrorBackground" Color="#45282C"/>
    <SolidColorBrush x:Key="SV.Brush.ChipErrorText" Color="#F07178"/>

    <!-- Grid -->
    <SolidColorBrush x:Key="SV.Brush.GridBackground" Color="#1F2329"/>
    <SolidColorBrush x:Key="SV.Brush.GridRow" Color="#23282F"/>
    <SolidColorBrush x:Key="SV.Brush.GridRowHover" Color="#2A3038"/>
    <SolidColorBrush x:Key="SV.Brush.GridRowSelected" Color="#2C4560"/>
    <SolidColorBrush x:Key="SV.Brush.GridLine" Color="#333A44"/>
    <SolidColorBrush x:Key="SV.Brush.GridHeaderBackground" Color="#2A3038"/>
    <SolidColorBrush x:Key="SV.Brush.GridHeaderText" Color="#C9D1DA"/>
    <SolidColorBrush x:Key="SV.Brush.GridTotalBackground" Color="#2A3038"/>

    <!-- Chart: fill blue above the axis, cut orange below (distinct for common colour-vision deficiencies) -->
    <SolidColorBrush x:Key="SV.Brush.ChartPlotBackground" Color="#1B1F24"/>
    <SolidColorBrush x:Key="SV.Brush.ChartFill" Color="#4FA3E0"/>
    <SolidColorBrush x:Key="SV.Brush.ChartCut" Color="#E0904F"/>
    <SolidColorBrush x:Key="SV.Brush.ChartAxis" Color="#8A94A1"/>
    <SolidColorBrush x:Key="SV.Brush.ChartLabel" Color="#A3ACB8"/>
    <SolidColorBrush x:Key="SV.Brush.ChartSelection" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SV.Brush.ChartCutMark" Color="#E0904F"/>
    <SolidColorBrush x:Key="SV.Brush.ChartHollow" Color="#6B7480"/>

    <!-- Scroll bars and tool tips -->
    <SolidColorBrush x:Key="SV.Brush.ScrollThumb" Color="#4A5360"/>
    <SolidColorBrush x:Key="SV.Brush.ScrollThumbHover" Color="#6B7686"/>
    <SolidColorBrush x:Key="SV.Brush.ToolTipBackground" Color="#2A3038"/>
    <SolidColorBrush x:Key="SV.Brush.ToolTipBorder" Color="#4A5360"/>
</ResourceDictionary>
