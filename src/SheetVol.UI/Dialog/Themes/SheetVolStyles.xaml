<!-- SheetVol control styles and templates. Written for SheetVol in the pattern of a
     chart-over-table vista; no Autodesk template, icon or font is copied. Every colour is a
     DynamicResource to a key in DarkTheme.xaml / LightTheme.xaml, so swapping the theme
     dictionary restyles the open window without reopening it (E908). Sizes are in
     device-independent units with Auto-sized text hosts, so 125-200 % scaling enlarges
     rather than clips (E909). -->
<ResourceDictionary x:Class="SheetVol.UI.Dialog.Themes.SheetVolStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dlg="clr-namespace:SheetVol.UI.Dialog">

    <!-- ===== Focus ===================================================================== -->
    <Style x:Key="SV.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="3" RadiusY="3" StrokeThickness="1.5" StrokeDashArray="2 1"
                               Stroke="{DynamicResource SV.Brush.FocusBorder}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text blocks by role (keyed; an implicit TextBlock style would reach into templates) == -->
    <Style x:Key="SV.CardHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.Text}"/>
    </Style>
    <Style x:Key="SV.FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.TextMuted}"/>
    </Style>
    <Style x:Key="SV.MutedTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.TextMuted}"/>
    </Style>
    <Style x:Key="SV.ErrorTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.Error}"/>
    </Style>
    <Style x:Key="SV.CellTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- ===== Cards and banners ============================================================= -->
    <Style x:Key="SV.CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SV.Brush.CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SV.Brush.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="8,8,8,0"/>
    </Style>
    <Style x:Key="SV.SubCardStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource SV.Brush.Separator}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,0,0,8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SV.WarningBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SV.Brush.WarningBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SV.Brush.WarningBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SV.Brush.Warning}"/>
    </Style>
    <Style x:Key="SV.InfoStripStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SV.Brush.InfoBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SV.Brush.InfoBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SV.Brush.Text}"/>
    </Style>
    <Style x:Key="SV.ErrorStripStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SV.Brush.ErrorBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SV.Brush.Error}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SV.Brush.Error}"/>
    </Style>
    <Style x:Key="SV.FieldHostStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
    </Style>

    <!-- ===== Buttons ======================================================================= -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SV.Brush.ButtonBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SV.Brush.ButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SV.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SV.Brush.ButtonHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SV.Brush.ButtonPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SV.Brush.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SV.PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SV.Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SV.Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.AccentText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SV.Brush.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SV.Brush.AccentPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SV.ScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text boxes ====================================================================== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SV.Brush.ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SV.Brush.ControlBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource SV.Brush.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource SV.Brush.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SV.Brush.ControlHoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SV.Brush.FocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SV.Brush.ControlReadOnlyBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SV.Brush.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A text field with its visible label and inline error, DataContext = TextFieldViewModel (E903, E910) -->
    <DataTemplate x:Key="SV.LabelledFieldTemplate">
        <StackPanel>
            <TextBlock Text="{Binding Label}" Style="{StaticResource SV.FieldLabelStyle}"/>
            <TextBox x:Name="Box" Text="{Binding Text, ValidatesOnNotifyDataErrors=False}"
                     IsReadOnly="{Binding IsEditable, Converter={x:Static dlg:Converters.Not}}"
                     dlg:FieldBehavior.CommitOnEnter="True"
                     AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Error, TargetNullValue=''}"/>
            <TextBlock Text="{Binding Error}" Style="{StaticResource SV.ErrorTextStyle}"
                       Visibility="{Binding HasError, Converter={x:Static dlg:Converters.TrueToVisible}}"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SV.Brush.Error}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The same without the visible label, for fields whose label sits elsewhere -->
    <DataTemplate x:Key="SV.FieldTemplate">
        <StackPanel>
            <TextBox x:Name="Box" Text="{Binding Text, ValidatesOnNotifyDataErrors=False}"
                     IsReadOnly="{Binding IsEditable, Converter={x:Static dlg:Converters.Not}}"
                     dlg:FieldBehavior.CommitOnEnter="True"
                     AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Error, TargetNullValue=''}"/>
            <TextBlock Text="{Binding Error}" Style="{StaticResource SV.ErrorTextStyle}"
                       Visibility="{Binding HasError, Converter={x:Static dlg:Converters.TrueToVisible}}"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SV.Brush.Error}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A grid cell showing a TextFieldViewModel (display mode); errors marked in place (E903) -->
    <DataTemplate x:Key="SV.CellFieldTemplate">
        <Border x:Name="Bd" BorderThickness="0,0,0,2" BorderBrush="Transparent" ToolTip="{Binding Error}"
                AutomationProperties.HelpText="{Binding Error, TargetNullValue=''}">
            <TextBlock x:Name="Text" Text="{Binding Text, ValidatesOnNotifyDataErrors=False}" Style="{StaticResource SV.CellTextStyle}"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsEditable}" Value="False">
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource SV.Brush.TextMuted}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SV.Brush.Error}"/>
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource SV.Brush.Error}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Check boxes ===================================================================== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SV.FocusVisual}"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="2" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0"
                                Background="{DynamicResource SV.Brush.ControlBackground}" BorderBrush="{DynamicResource SV.Brush.ControlBorder}">
                            <Path x:Name="Mark" Data="M 2.5 7.5 L 6 11 L 12.5 3.5" StrokeThickness="2" Visibility="Collapsed"
                                  Stroke="{DynamicResource SV.Brush.AccentText}"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SV.Brush.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SV.Brush.Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SV.Brush.ControlHoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SV.Brush.TextDisabled}"/>
                            <Setter TargetName="Box" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Combo boxes ===================================================================== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.Text}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SV.Brush.ItemHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SV.Brush.Selection}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource SV.Brush.ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SV.Brush.ControlBorder}"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="6,3,24,3"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SV.FocusVisual}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="3" SnapsToDevicePixels="True">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                              Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource SV.Brush.TextMuted}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SV.Brush.ControlHoverBorder}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" BorderThickness="1"
                                    Background="{DynamicResource SV.Brush.ControlBackground}" BorderBrush="{DynamicResource SV.Brush.ControlBorder}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource SV.Brush.FocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SV.Brush.TextDisabled}"/>
                            <Setter TargetName="Toggle" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scroll bars ======================================================================= -->
    <Style x:Key="SV.ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="4" Margin="2" Background="{DynamicResource SV.Brush.ScrollThumb}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SV.Brush.ScrollThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SV.Brush.ScrollThumbHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="SV.VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SV.ScrollPageButtonStyle}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SV.ScrollThumbStyle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SV.ScrollPageButtonStyle}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="SV.HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource SV.ScrollPageButtonStyle}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SV.ScrollThumbStyle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource SV.ScrollPageButtonStyle}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="11"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template" Value="{StaticResource SV.VerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="Template" Value="{StaticResource SV.HorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Tool tips and progress ============================================================= -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource SV.Brush.ToolTipBackground}" BorderBrush="{DynamicResource SV.Brush.ToolTipBorder}"
                            BorderThickness="1" CornerRadius="3" Padding="8,5" MaxWidth="420">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource SV.Brush.ControlBackground}"
                                BorderBrush="{DynamicResource SV.Brush.ControlBorder}" BorderThickness="1"/>
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{DynamicResource SV.Brush.Accent}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource SV.Brush.Separator}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SV.FocusVisual}"/>
    </Style>

    <!-- ===== Status chip (Current, Out of date, Error), DataContext = SegmentRowViewModel ======== -->
    <DataTemplate x:Key="SV.StatusChipTemplate">
        <Border x:Name="Chip" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                Background="{DynamicResource SV.Brush.ChipOutOfDateBackground}"
                AutomationProperties.Name="{Binding StatusText}">
            <TextBlock x:Name="ChipText" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SV.Brush.ChipOutOfDateText}"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Current">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SV.Brush.ChipCurrentBackground}"/>
                <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SV.Brush.ChipCurrentText}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Error">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SV.Brush.ChipErrorBackground}"/>
                <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SV.Brush.ChipErrorText}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Data grid ============================================================================ -->
    <dlg:HeaderTemplateSelector x:Key="SV.HeaderTemplateSelector">
        <dlg:HeaderTemplateSelector.TextTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
            </DataTemplate>
        </dlg:HeaderTemplateSelector.TextTemplate>
    </dlg:HeaderTemplateSelector>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SV.Brush.GridHeaderBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.GridHeaderText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SV.Brush.GridLine}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ContentTemplateSelector" Value="{StaticResource SV.HeaderTemplateSelector}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Cursor="SizeWE" Opacity="0"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                            Padding="6,3" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SV.Brush.FocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEditing" Value="True">
                            <Setter TargetName="Bd" Property="Padding" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource SV.Brush.GridRow}"/>
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.Text}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Number}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SV.Brush.GridRowHover}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SV.Brush.ErrorRowTint}"/>
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SV.Brush.GridRowSelected}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SV.Brush.GridBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource SV.Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SV.Brush.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SV.Brush.GridLine}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource SV.Brush.GridLine}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.Row="0" Grid.Column="0"/>
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" Grid.Column="0"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="1" Orientation="Vertical"
                                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="2" Grid.Column="0" Orientation="Horizontal"
                                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
